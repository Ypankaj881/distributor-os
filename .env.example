# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it holds secrets.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Replace <db_password> with the database user's password.
MONGODB_URI=mongodb+srv://USER:<db_password>@cluster0.example.mongodb.net/?appName=Cluster0
# Database name inside the cluster.
MONGODB_DB=distributor_os

# Secret used to sign login sessions. At least 32 characters, random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Public URL of this app (used for links, e.g. WhatsApp share).
APP_URL=http://localhost:3000

# V1 runs for a single distributor. Login resolves the company by this slug.
DEFAULT_COMPANY_SLUG=chandrika

# ---- Bootstrap values for `npm run admin:create` (optional here) ----
# Safer: set ADMIN_PASSWORD in the terminal for one command instead of saving it.
# COMPANY_NAME=Chandrika Enterprises
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PHONE=
# ADMIN_PASSWORD=
